# ---------------------------------------------------------------------------
# Bu dosyayı ".env" adıyla kopyalayıp değerleri doldurun. .env git'e GİRMEZ.
#   - docker compose bu dosyayı otomatik okur (container şifreleri)
#   - API açılışta bu dosyayı okur (FootballSocialMedia.Api/Configuration/DotEnv.cs)
# API anahtarlarında iç içe ayarlar "__" ile yazılır: TokenOption__SecurityKey = TokenOption:SecurityKey
# Değerlerde ${DIGER_ANAHTAR} kullanılabilir.
# ---------------------------------------------------------------------------

# --- Docker container şifreleri ---
MSSQL_SA_PASSWORD=
RABBITMQ_USER=
RABBITMQ_PASSWORD=
MONGO_USER=admin
MONGO_PASSWORD=

# --- Connection string'ler ---
ConnectionStrings__SqlServer=Server=localhost,1433;Database=SocialMediaDb;User Id=sa;Password=${MSSQL_SA_PASSWORD};TrustServerCertificate=True;
ConnectionStrings__Redis=localhost:6377
ConnectionStrings__MongoDb=mongodb://${MONGO_USER}:${MONGO_PASSWORD}@localhost:27018/admin
ConnectionStrings__RabbitMQ=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@localhost:5672

# --- JWT imzalama anahtarı (en az 32 karakter, rastgele) ---
TokenOption__SecurityKey=

# --- Cloudinary (https://console.cloudinary.com → API Keys) ---
CloudinarySettings__CloudName=
CloudinarySettings__ApiKey=
CloudinarySettings__ApiSecret=

# --- Development'ta otomatik oluşturulan admin hesabının şifresi (e-posta appsettings'te) ---
SeedAdmin__Password=
