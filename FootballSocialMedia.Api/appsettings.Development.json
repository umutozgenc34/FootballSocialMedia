{
  "//": "Secret'lar (connection string'ler, Cloudinary, JWT SecurityKey, admin şifresi) repo kökündeki .env dosyasında. Bkz. .env.example",
  "Database": {
    "UseInMemory": false
  },
  "Cors": {
    "Origins": [
      "http://localhost:5173"
    ]
  },
  "SeedAdmin": {
    "UserName": "admin",
    "Email": "admin@fsm.com"
  },
  "Elasticsearch": {
    "Url": "http://localhost:9200"
  },
  "TokenOption": {
    "Issuer": "www.footballtalks.com",
    "Audience": [
      "www.footballtalks.com"
    ],
    "AccessTokenExpiration": 10,
    "RefreshTokenExpiration": 600
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
